<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Base XML theme. All real theming happens in Jetpack Compose
      (presentation/theme/Theme.kt). This theme only guarantees a black
      background and no action bar before the first frame is drawn.
    -->
    <style name="Theme.VisionAid" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>
</resources>
